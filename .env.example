# Copy to .env and fill in. Never commit .env (RULES.md R-SEC-1).
# Optional: without a key, FloatWise uses deterministic template explanations.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# demo: loopback clients only. required: username/password login and server sessions.
# Never expose demo mode through a reverse proxy or public listener.
FLOATWISE_AUTH_MODE=demo
# Run: python run.py auth-setup (creates viewer/operator/admin accounts; shows passwords once).
# Account configuration contains password hashes, never plaintext passwords.
# roles: viewer (read), operator (read, decisions, simulate), admin (also operations/audit).
# Format: [{"username":"operator","role":"operator","password_hash":"<generated-hash>"}]
FLOATWISE_USERS=
# Optional legacy API clients; the browser uses an HttpOnly session cookie.
FLOATWISE_CREDENTIALS=
# Local simulated connector: generated by python run.py integration-setup.
FLOATWISE_INTEGRATION_TOKEN=
FLOATWISE_INTEGRATION_API=http://127.0.0.1:8000
